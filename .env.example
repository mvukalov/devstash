# ─────────────────────────────────────────────
# Database — Neon (serverless PostgreSQL)
# ─────────────────────────────────────────────
# Copy this file to .env and fill in the values from the Neon dashboard.
# .env is gitignored — never commit real credentials.
#
# Neon gives you two connection strings per branch. You need both:
#
#   DATABASE_URL — the POOLED endpoint (host contains "-pooler").
#                  Used by the app at runtime via the Prisma driver adapter.
#                  Pooling keeps serverless functions from exhausting connections.
#
#   DIRECT_URL   — the UNPOOLED/direct endpoint (no "-pooler" in the host).
#                  Used by the Prisma CLI for migrations, which need advisory
#                  locks and session state that PgBouncer's transaction mode
#                  does not support.
#
# Point these at the DEVELOPMENT branch locally. Production env vars point at
# the production branch, where deploys run `prisma migrate deploy`.

DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ─────────────────────────────────────────────
# Auth — NextAuth v5 (Auth.js)
# ─────────────────────────────────────────────
# AUTH_SECRET  — signs and encrypts the session JWT. Generate one with:
#                  npx auth secret
#                Any random 32+ byte string works; use a different value per
#                environment, and rotating it signs everybody out.
#
# AUTH_GITHUB_* — from a GitHub OAuth app
#                 (Settings -> Developer settings -> OAuth Apps -> New).
#                 Homepage URL:              http://localhost:3000
#                 Authorization callback URL: http://localhost:3000/api/auth/callback/github
#                 Production needs its own OAuth app pointed at the real domain.

AUTH_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
